# UYEA 悠野工作室 - Cloudflare Pages 自定义头部

# 静态资源长期缓存（版本号控制缓存失效）
/CSS/*
  Cache-Control: public, max-age=31536000, immutable

/JS/*
  Cache-Control: public, max-age=31536000, immutable

/IMAGE/*
  Cache-Control: public, max-age=31536000, immutable

/FONT/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 短期缓存
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  Vary: Accept-Encoding

# JSON 数据短期缓存
/JSON/*
  Cache-Control: public, max-age=3600, must-revalidate

# posts.json 缩短边缘缓存（动态数据，需更频繁更新）
/JSON/posts.json
  Cache-Control: public, max-age=60, s-maxage=60, must-revalidate

# Service Worker 不缓存
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 安全与性能头部
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://timor.tech; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  alt-svc: clear
